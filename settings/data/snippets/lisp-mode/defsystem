# -*- mode: snippet -*-
# name: defsystem
# key: defsystem
# --
(defsystem $1
  :version "0.1.0"
  :description ""
  :license "MIT"
  :author ""
  :depends-on (:alexandria
               :str
               :local-time
               :arrow-macros
               :frugal-uuid
               :filepaths
               :mito)
  :serial t
  :components ((:module "src"
                :components
                ((:file "$1"))))
  :in-order-to ((test-op (test-op :$1-tests))))

(defsystem $1-tests
  :version "0.1.0"
  :license "MIT"
  :author ""
  :depends-on (:fiveam)
  :serial t
  :components ((:module "test"
                :components
                ((:file "$1"))))
  :perform (test-op (op c)
                    (symbol-call :fiveam :run!
                                 (find-symbol* :$1 :$1-tests))))